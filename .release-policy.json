{
  "repository": "ha-homelab/ha-onvif-room-direction",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "version",
  "validation_workflows": [
    "tests.yml",
    "security.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "python3 -m ruff check custom_components tests scripts/build-release.py scripts/build-demo.py",
    "python3 -m pytest -q",
    "python3 scripts/build-release.py"
  ],
  "notes": [
    "Examples and screenshots are synthetic. Site configuration, credentials, real observations and private Git history are excluded.",
    "Offline tests cover simulated boundaries. A beta release does not establish compatibility with every camera, network or Home Assistant installation."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": true,
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "version",
        "format": "text",
        "value": "package"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "value": "package"
      },
      {
        "path": "custom_components/onvif_room_direction/manifest.json",
        "format": "json",
        "field": "version",
        "value": "package"
      },
      {
        "path": "custom_components/onvif_room_direction/const.py",
        "format": "python",
        "field": "VERSION",
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "onvif_room_direction.zip",
        "format": "zip-json",
        "member": "manifest.json",
        "field": "version",
        "value": "package"
      }
    ],
    "toolkit_revision": "ece79d1b1ca40d3068d373e515daf58115489a22"
  },
  "toolkit_revision": "ece79d1b1ca40d3068d373e515daf58115489a22",
  "sign_releases": true
}
